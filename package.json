{
  "name": "scribe-drop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "volta": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "pnpm --recursive --filter '@scribe-drop/*' run build",
    "candidate:application:create": "node scripts/create-candidate-application.mjs",
    "candidate:application:verify": "node scripts/verify-candidate-application.mjs",
    "candidate:create": "node scripts/create-release-candidate.mjs",
    "candidate:pages": "node scripts/prepare-pages-candidate.mjs",
    "candidate:pages-functions:verify": "node scripts/verify-pages-functions-build.mjs",
    "candidate:verify": "node scripts/verify-release-candidate.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm candidate:pages-functions:verify && pnpm d1:verify && pnpm ci:verify",
    "ci:verify": "node scripts/verify-ci-workflows.mjs",
    "cloudflare": "wrangler",
    "cloudflare:access:control-plane:verify:staging": "node scripts/verify-staging-access-control-plane.mjs",
    "cloudflare:access:service:verify:staging": "node scripts/verify-staging-service-token.mjs",
    "cloudflare:access:verify:staging": "node scripts/verify-staging-access.mjs",
    "cloudflare:access:verify:production": "node scripts/verify-production-access.mjs",
    "cloudflare:config:staging": "node scripts/render-cloudflare-staging-config.mjs all",
    "cloudflare:config:staging:orchestrator": "node scripts/render-cloudflare-staging-config.mjs orchestrator",
    "cloudflare:config:staging:r2-cors": "node scripts/render-cloudflare-staging-config.mjs r2-cors",
    "cloudflare:config:staging:r2-lifecycle": "node scripts/render-cloudflare-staging-config.mjs r2-lifecycle",
    "cloudflare:config:staging:web": "node scripts/render-cloudflare-staging-config.mjs web",
    "cloudflare:config:production": "node scripts/render-cloudflare-production-config.mjs all",
    "cloudflare:config:production:orchestrator": "node scripts/render-cloudflare-production-config.mjs orchestrator",
    "cloudflare:config:production:r2-cors": "node scripts/render-cloudflare-production-config.mjs r2-cors",
    "cloudflare:config:production:r2-lifecycle": "node scripts/render-cloudflare-production-config.mjs r2-lifecycle",
    "cloudflare:config:production:web": "node scripts/render-cloudflare-production-config.mjs web",
    "cloudflare:secrets:verify:staging": "pnpm cloudflare:secrets:verify:staging:pages && pnpm cloudflare:secrets:verify:staging:orchestrator",
    "cloudflare:secrets:verify:staging:orchestrator": "node scripts/verify-staging-worker-secrets.mjs",
    "cloudflare:secrets:verify:staging:pages": "node scripts/verify-cloudflare-pages-secrets.mjs",
    "cloudflare:secrets:verify:production": "pnpm cloudflare:secrets:verify:production:pages && pnpm cloudflare:secrets:verify:production:orchestrator",
    "cloudflare:secrets:verify:production:orchestrator": "node scripts/verify-production-worker-secrets.mjs",
    "cloudflare:secrets:verify:production:pages": "node scripts/verify-production-pages-secrets.mjs",
    "cloudflare:readback:production": "node scripts/verify-cloudflare-readback.mjs production",
    "cloudflare:readback:staging": "node scripts/verify-cloudflare-readback.mjs staging",
    "cloudflare:pages:promote:staging": "node scripts/promote-pages-candidate.mjs",
    "cloudflare:pages:upload-permission:verify:staging": "node scripts/verify-staging-pages-upload-permission.mjs",
    "container:build:runpod": "docker buildx build --load --tag scribe-drop-runpod-worker:local --file apps/runpod-worker/Dockerfile .",
    "container:check:runpod": "docker run --rm --network none --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m --entrypoint python scribe-drop-runpod-worker:local -m scribe_drop_worker.container_check",
    "d1:migrate:local": "wrangler d1 migrations apply SCRIBE_DROP_DB --local --config apps/orchestrator/wrangler.toml",
    "d1:verify": "node scripts/verify-d1-migrations.mjs",
    "environment:policy:export": "node scripts/export-environment-policy.mjs",
    "format": "pnpm format:ts && pnpm format:py",
    "format:check": "pnpm format:check:ts && pnpm format:check:py",
    "format:check:py": "uv run --directory apps/runpod-worker ruff format --check .",
    "format:check:ts": "prettier --check .",
    "format:py": "uv run --directory apps/runpod-worker ruff format .",
    "format:ts": "prettier --write .",
    "gitleaks": "./.tools/bin/gitleaks",
    "gitleaks:install": "bash scripts/install-gitleaks.sh",
    "lint": "pnpm lint:ts && pnpm lint:py",
    "lint:py": "uv run --directory apps/runpod-worker ruff check .",
    "lint:ts": "eslint . --max-warnings 0",
    "security:audit": "pnpm audit --audit-level high && uv audit --preview-features audit-command --project apps/runpod-worker --frozen",
    "staging:acceptance:create": "node scripts/create-staging-acceptance.mjs",
    "staging:acceptance:verify": "node scripts/verify-staging-acceptance.mjs",
    "staging:e2e:fixture:verify": "node scripts/verify-staging-e2e-fixture.mjs",
    "runpodctl": "./.tools/bin/runpodctl",
    "runpodctl:install": "bash scripts/install-runpodctl.sh",
    "runpod:config:staging": "node scripts/render-runpod-environment-config.mjs staging",
    "runpod:config:production": "node scripts/render-runpod-environment-config.mjs production",
    "runpod:deploy:staging": "node scripts/deploy-runpod-environment.mjs staging",
    "runpod:deploy:production": "node scripts/deploy-runpod-environment.mjs production",
    "runpod:promote:production": "node scripts/promote-runpod-candidate.mjs production .runpod/deploy/production-plan.json",
    "runpod:promote:staging": "node scripts/promote-runpod-candidate.mjs staging .runpod/deploy/staging-plan.json",
    "runpod:preflight:production": "node scripts/promote-runpod-candidate.mjs production .runpod/deploy/production-plan.json --preflight-only",
    "runpod:preflight:staging": "node scripts/promote-runpod-candidate.mjs staging .runpod/deploy/staging-plan.json --preflight-only",
    "runpod:release-readiness:staging": "node scripts/verify-runpod-release-readiness.mjs staging",
    "playwright:install": "pnpm --filter @scribe-drop/e2e exec playwright install chromium",
    "secrets:check": "pnpm secrets:check:git && pnpm secrets:check:worktree",
    "secrets:check:git": "./.tools/bin/gitleaks git --redact --no-banner --verbose",
    "secrets:check:worktree": "./.tools/bin/gitleaks dir . --redact --no-banner --verbose",
    "test": "pnpm test:ts && pnpm test:py",
    "test:e2e": "pnpm --filter @scribe-drop/e2e run test",
    "test:e2e:staging": "pnpm --filter @scribe-drop/e2e run test:staging",
    "test:e2e:staging:readiness": "pnpm --filter @scribe-drop/e2e run test:staging:readiness",
    "test:py": "uv run --directory apps/runpod-worker pytest",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:ts": "pnpm test:scripts && vitest run && pnpm --filter @scribe-drop/web run test:workers && pnpm --filter @scribe-drop/orchestrator run test:workers",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "typecheck": "pnpm typecheck:ts && pnpm typecheck:py",
    "typecheck:py": "uv run --directory apps/runpod-worker mypy --strict src tests",
    "typecheck:ts": "pnpm --recursive --filter '@scribe-drop/*' run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
