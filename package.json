{
  "name": "scribe-drop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "volta": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "pnpm --recursive --filter '@scribe-drop/*' run build",
    "candidate:application:create": "node scripts/create-candidate-application.mjs",
    "candidate:application:verify": "node scripts/verify-candidate-application.mjs",
    "candidate:create": "node scripts/create-release-candidate.mjs",
    "candidate:pages": "node scripts/prepare-pages-candidate.mjs",
    "candidate:pages-functions:verify": "node scripts/verify-pages-functions-build.mjs",
    "candidate:verify": "node scripts/verify-release-candidate.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm workflow:build:gpu-controller && pnpm test && pnpm build && pnpm candidate:pages-functions:verify && pnpm d1:verify && pnpm ci:verify",
    "ci:verify": "pnpm cloudflare:permissions:verify && node scripts/verify-ci-workflows.mjs",
    "cloudflare": "wrangler",
    "cloudflare:permissions:verify": "node scripts/verify-cloudflare-credential-policy.mjs",
    "cloudflare:access:control-plane:verify:staging": "node scripts/verify-staging-access-control-plane.mjs",
    "cloudflare:access:service:verify:staging": "node scripts/verify-staging-service-token.mjs",
    "cloudflare:access:verify:staging": "node scripts/verify-staging-access.mjs",
    "cloudflare:access:verify:production": "node scripts/verify-production-access.mjs",
    "cloudflare:config:staging": "node scripts/render-cloudflare-staging-config.mjs all",
    "cloudflare:config:staging:orchestrator": "node scripts/render-cloudflare-staging-config.mjs orchestrator",
    "cloudflare:config:staging:r2-cors": "node scripts/render-cloudflare-staging-config.mjs r2-cors",
    "cloudflare:config:staging:r2-lifecycle": "node scripts/render-cloudflare-staging-config.mjs r2-lifecycle",
    "cloudflare:config:staging:web": "node scripts/render-cloudflare-staging-config.mjs web",
    "cloudflare:config:production": "node scripts/render-cloudflare-production-config.mjs all",
    "cloudflare:waf:cloud-run:apply:staging": "node scripts/manage-staging-cloud-run-waf.mjs apply",
    "cloudflare:waf:cloud-run:read:staging": "node scripts/manage-staging-cloud-run-waf.mjs read",
    "cloudflare:waf:cloud-run:remove:staging": "node scripts/manage-staging-cloud-run-waf.mjs remove",
    "cloudflare:config:production:orchestrator": "node scripts/render-cloudflare-production-config.mjs orchestrator",
    "cloudflare:config:production:r2-cors": "node scripts/render-cloudflare-production-config.mjs r2-cors",
    "cloudflare:config:production:r2-lifecycle": "node scripts/render-cloudflare-production-config.mjs r2-lifecycle",
    "cloudflare:config:production:web": "node scripts/render-cloudflare-production-config.mjs web",
    "cloudflare:secrets:verify:staging": "pnpm cloudflare:secrets:verify:staging:pages && pnpm cloudflare:secrets:verify:staging:orchestrator",
    "cloudflare:secrets:verify:staging:orchestrator": "node scripts/verify-staging-worker-secrets.mjs",
    "cloudflare:secrets:verify:staging:pages": "node scripts/verify-cloudflare-pages-secrets.mjs",
    "cloudflare:secrets:verify:production": "pnpm cloudflare:secrets:verify:production:pages && pnpm cloudflare:secrets:verify:production:orchestrator",
    "cloudflare:secrets:verify:production:orchestrator": "node scripts/verify-production-worker-secrets.mjs",
    "cloudflare:secrets:verify:production:pages": "node scripts/verify-production-pages-secrets.mjs",
    "cloudflare:readback:production": "node scripts/verify-cloudflare-readback.mjs production",
    "cloudflare:readback:staging": "node scripts/verify-cloudflare-readback.mjs staging",
    "cloudflare:pages:promote:staging": "node scripts/promote-pages-candidate.mjs",
    "cloudflare:pages:upload-permission:verify:production": "node scripts/verify-production-pages-upload-permission.mjs",
    "github:controls:verify:production": "node scripts/verify-production-github-controls.mjs",
    "github:controls:verify:staging": "node scripts/verify-staging-github-controls.mjs",
    "cloudflare:pages:upload-permission:verify:staging": "node scripts/verify-staging-pages-upload-permission.mjs",
    "cloudflare:worker-route:verify:production": "node scripts/verify-cloudflare-worker-route-permission.mjs production",
    "cloudflare:worker-route:verify:staging": "node scripts/verify-cloudflare-worker-route-permission.mjs staging",
    "cloud-run:candidate:evidence": "node scripts/cloud-run-candidate-evidence.mjs",
    "cloud-run:controller:deploy": "node scripts/manage-cloud-run-controller-deployment.mjs",
    "cloud-run:foundation:apply": "node scripts/manage-cloud-run-deployment-foundation.mjs apply --confirm-production-foundation",
    "cloud-run:foundation:apply:release-deployer-role": "node scripts/manage-cloud-run-deployment-foundation.mjs apply-release-deployer-role --confirm-release-deployer-role",
    "cloud-run:foundation:apply:staging-preflight": "node scripts/manage-cloud-run-deployment-foundation.mjs apply-staging-preflight --confirm-staging-preflight-foundation",
    "cloud-run:foundation:read": "node scripts/verify-cloud-run-deployment-foundation.mjs",
    "cloud-run:staging:inputs:verify": "node scripts/verify-staging-release-inputs.mjs",
    "cloud-run:staging:bootstrap-preflight": "node scripts/manage-cloud-run-staging-bootstrap-preflight.mjs",
    "cloud-run:staging:paid-readiness": "node scripts/verify-staging-cloud-run-paid-readiness.mjs",
    "cloud-run:staging:safety": "node scripts/verify-staging-cloud-run-safety.mjs",
    "cloud-run:production:smoke:verify": "node scripts/verify-production-smoke.mjs",
    "cloud-run:production:origin:export": "node scripts/export-cloud-run-controller-origin.mjs",
    "cloud-run:production:worker-secrets:put": "node scripts/put-production-cloud-run-worker-secrets.mjs",
    "production:promotion:inputs:verify": "node scripts/verify-production-promotion-inputs.mjs",
    "production:preflight:verify": "node scripts/verify-production-preflight-run.mjs",
    "production:provider:drain:verify": "node scripts/verify-production-provider-drain.mjs",
    "production:cutover:evidence": "node scripts/production-cutover-evidence.mjs",
    "production:release:evidence": "node scripts/production-release-evidence.mjs",
    "cloud-run:acceptance:clean": "node scripts/verify-cloud-run-acceptance-clean.mjs",
    "cloud-run:acceptance:recovered": "node scripts/verify-recovered-cloud-run-acceptance.mjs",
    "container:build:runpod": "docker buildx build --load --tag scribe-drop-runpod-worker:local --file apps/runpod-worker/Dockerfile .",
    "container:build:quality:runpod": "docker buildx build --load --tag scribe-drop-runpod-worker-quality:local --build-arg WORKER_IMAGE=scribe-drop-runpod-worker:local --file apps/runpod-worker/quality.Dockerfile .",
    "container:build:cloud-run": "docker buildx build --load --tag scribe-drop-cloud-run-worker:local --build-arg WORKER_IMAGE=scribe-drop-runpod-worker:local --file apps/runpod-worker/cloud-run.Dockerfile .",
    "container:build:gpu-controller": "node scripts/build-gpu-controller-image.mjs",
    "container:check:runpod": "docker run --rm --network none --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m --entrypoint python scribe-drop-runpod-worker:local -m scribe_drop_worker.container_check",
    "container:check:bounded:runpod": "docker run --rm --network none --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m --entrypoint python scribe-drop-runpod-worker:local -m scribe_drop_worker.bounded_container_check",
    "container:check:quality:runpod": "docker run --rm --gpus device=0 --network none --read-only --tmpfs /tmp:rw,noexec,nosuid,size=128m scribe-drop-runpod-worker-quality:local",
    "container:check:cloud-run": "docker run --rm --network none --read-only --tmpfs /tmp:rw,noexec,nosuid,size=3g --entrypoint python scribe-drop-cloud-run-worker:local -m scribe_drop_worker.one_shot_container_check",
    "container:check:gpu-controller": "node scripts/verify-gpu-controller-image.mjs",
    "container:scan:runpod": "./.tools/bin/trivy image --cache-dir .tools/trivy-cache --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed=false --exit-code 1 --format table --table-mode detailed --quiet --skip-version-check --timeout 15m scribe-drop-runpod-worker:local",
    "container:scan:quality:runpod": "./.tools/bin/trivy image --cache-dir .tools/trivy-cache --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed=false --exit-code 1 --format table --table-mode detailed --quiet --skip-version-check --timeout 15m scribe-drop-runpod-worker-quality:local",
    "container:scan:cloud-run": "./.tools/bin/trivy image --cache-dir .tools/trivy-cache --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed=false --exit-code 1 --format table --table-mode detailed --quiet --skip-version-check --timeout 15m scribe-drop-cloud-run-worker:local",
    "container:scan:gpu-controller": "./.tools/bin/trivy image --cache-dir .tools/trivy-cache --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed=false --exit-code 1 --format table --table-mode detailed --quiet --skip-version-check --timeout 15m scribe-drop-gpu-controller:local",
    "container:sbom:cloud-run": "./.tools/bin/trivy image --cache-dir .tools/trivy-cache --scanners vuln --format cyclonedx --output /tmp/scribe-drop-cloud-run-worker.cdx.json --quiet --skip-version-check --timeout 15m scribe-drop-cloud-run-worker:local",
    "container:sbom:gpu-controller": "./.tools/bin/trivy image --cache-dir .tools/trivy-cache --scanners vuln --format cyclonedx --output /tmp/scribe-drop-gpu-controller.cdx.json --quiet --skip-version-check --timeout 15m scribe-drop-gpu-controller:local",
    "d1:migrate:local": "wrangler d1 migrations apply SCRIBE_DROP_DB --local --config apps/orchestrator/wrangler.toml",
    "d1:verify": "node scripts/verify-d1-migrations.mjs",
    "environment:policy:export": "node scripts/export-environment-policy.mjs",
    "format": "pnpm format:ts && pnpm format:py",
    "format:check": "pnpm format:check:ts && pnpm format:check:py",
    "format:check:py": "uv run --directory apps/runpod-worker ruff format --check .",
    "format:check:ts": "prettier --check .",
    "format:py": "uv run --directory apps/runpod-worker ruff format .",
    "format:ts": "prettier --write .",
    "gcloud:install": "bash scripts/install-google-cloud-cli.sh",
    "gcloud:login": "env CLOUDSDK_CONFIG=.tools/gcloud-config ./.tools/bin/gcloud auth login --no-launch-browser",
    "gitleaks": "./.tools/bin/gitleaks",
    "gitleaks:install": "bash scripts/install-gitleaks.sh",
    "lint": "pnpm lint:ts && pnpm lint:py",
    "lint:py": "uv run --directory apps/runpod-worker ruff check .",
    "lint:ts": "eslint . --max-warnings 0",
    "security:audit": "pnpm audit --audit-level high && uv audit --preview-features audit-command --project apps/runpod-worker --frozen",
    "staging:acceptance:create": "node scripts/create-staging-acceptance.mjs",
    "staging:acceptance:resume:verify": "node scripts/verify-staging-acceptance-resume.mjs",
    "staging:acceptance:verify": "node scripts/verify-staging-acceptance.mjs",
    "staging:dispatch:verify": "node scripts/verify-staging-dispatch-uniqueness.mjs",
    "staging:resume:inputs:verify": "node scripts/verify-staging-resume-inputs.mjs",
    "staging:e2e:fixture:verify": "node scripts/verify-staging-e2e-fixture.mjs",
    "staging:failure-notification:verify": "node scripts/verify-staging-failure-notification.mjs",
    "runpodctl": "./.tools/bin/runpodctl",
    "runpodctl:install": "bash scripts/install-runpodctl.sh",
    "runpod:config:staging": "node scripts/render-runpod-environment-config.mjs staging",
    "runpod:config:production": "node scripts/render-runpod-environment-config.mjs production",
    "runpod:deploy:staging": "node scripts/deploy-runpod-environment.mjs staging",
    "runpod:deploy:production": "node scripts/deploy-runpod-environment.mjs production",
    "runpod:promote:production": "node scripts/promote-runpod-candidate.mjs production .runpod/deploy/production-plan.json",
    "runpod:promote:staging": "node scripts/promote-runpod-candidate.mjs staging .runpod/deploy/staging-plan.json",
    "runpod:prewarm:staging": "node scripts/manage-staging-runpod-active-worker.mjs prewarm",
    "runpod:prewarm-after-refresh:staging": "node scripts/manage-staging-runpod-active-worker.mjs prewarm-after-refresh",
    "runpod:cooldown:staging": "node scripts/manage-staging-runpod-active-worker.mjs cooldown",
    "runpod:preflight:production": "node scripts/promote-runpod-candidate.mjs production .runpod/deploy/production-plan.json --preflight-only",
    "runpod:capacity:prepare:production": "node scripts/prepare-runpod-production-capacity.mjs",
    "runpod:preflight:staging": "node scripts/promote-runpod-candidate.mjs staging .runpod/deploy/staging-plan.json --preflight-only",
    "runpod:verify-worker:staging": "node scripts/promote-runpod-candidate.mjs staging .runpod/deploy/staging-plan.json --preflight-only --require-candidate-worker",
    "runpod:release-readiness:staging": "node scripts/verify-runpod-release-readiness.mjs staging",
    "playwright:install": "pnpm --filter @scribe-drop/e2e exec playwright install chromium",
    "secrets:check": "pnpm secrets:check:git && pnpm secrets:check:worktree",
    "secrets:check:git": "./.tools/bin/gitleaks git --redact --no-banner --verbose",
    "secrets:check:worktree": "./.tools/bin/gitleaks dir . --redact --no-banner --verbose",
    "test": "pnpm test:ts && pnpm test:py",
    "test:e2e": "pnpm --filter @scribe-drop/e2e run test",
    "test:e2e:staging": "pnpm --filter @scribe-drop/e2e run test:staging",
    "test:e2e:staging:readiness": "pnpm --filter @scribe-drop/e2e run test:staging:readiness",
    "test:py": "uv run --directory apps/runpod-worker pytest",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:ts": "pnpm test:scripts && vitest run && pnpm --filter @scribe-drop/web run test:workers && pnpm --filter @scribe-drop/orchestrator run test:workers",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "trivy": "./.tools/bin/trivy",
    "trivy:install": "bash scripts/install-trivy.sh",
    "typecheck": "pnpm typecheck:ts && pnpm typecheck:py",
    "typecheck:py": "uv run --directory apps/runpod-worker mypy --strict src tests",
    "typecheck:ts": "pnpm --recursive --filter '@scribe-drop/*' run typecheck",
    "workflow:build:gpu-controller": "pnpm --filter '@scribe-drop/gpu-controller...' run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
