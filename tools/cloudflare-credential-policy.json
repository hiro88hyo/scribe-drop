{
  "schemaVersion": 1,
  "accountScope": "exact-account",
  "roles": [
    {
      "id": "backend-control-plane",
      "credentialType": "cloudflare-api-token",
      "credentialName": "CLOUDFLARE_API_TOKEN",
      "placement": [
        "github-environment:staging",
        "github-environment:production",
        "local-credential-store:temporary"
      ],
      "accountPermissions": [
        "Access: Apps and Policies Edit",
        "Access: Service Tokens Edit",
        "D1 Edit",
        "Queues Edit",
        "Workers R2 Storage Edit",
        "Workers Scripts Edit"
      ],
      "zonePermissions": ["Workers Routes Read", "Zone Read"],
      "zoneScope": "exact-application-zone",
      "capabilities": [
        "access-application-policy-and-service-token-management",
        "access-service-token-rotation",
        "d1-migration-and-readback",
        "queue-consumer-and-dlq-management",
        "r2-cors-lifecycle-and-event-notification-management",
        "resolve-the-application-zone-and-read-existing-worker-routes",
        "worker-deploy-secret-schedule-binding-and-custom-domain-management"
      ]
    },
    {
      "id": "pages-ci",
      "credentialType": "cloudflare-api-token",
      "credentialName": "CLOUDFLARE_PAGES_API_TOKEN",
      "placement": ["github-environment:staging", "github-environment:production"],
      "accountPermissions": ["Cloudflare Pages Edit"],
      "zonePermissions": [],
      "capabilities": [
        "pages-project-deployment-and-config-readback",
        "pages-upload-capability-preflight",
        "pages-deploy-and-secret-management"
      ]
    },
    {
      "id": "r2-parent-signer",
      "credentialType": "r2-s3-api-token",
      "credentialNames": ["R2_PARENT_ACCESS_KEY_ID", "R2_PARENT_SECRET_ACCESS_KEY"],
      "placement": ["cloudflare-pages-secret:staging", "cloudflare-pages-secret:production"],
      "dashboardPermissions": ["Object Read & Write"],
      "resourceScope": "exact-environment-bucket",
      "capabilities": ["locally-sign-short-lived-exact-object-r2-temporary-credentials"]
    },
    {
      "id": "staging-access-service-principal",
      "credentialType": "cloudflare-access-service-token",
      "credentialNames": ["CF_ACCESS_CLIENT_ID", "CF_ACCESS_CLIENT_SECRET"],
      "placement": ["github-environment:staging"],
      "applicationScope": "exact-staging-custom-hostname-and-pages-preview-applications",
      "productionAllowed": false,
      "capabilities": ["staging-service-auth-and-browser-e2e"]
    }
  ]
}
